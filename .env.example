# ---------------------------------------------------------------------------
# view-info — environment variables
# Copy to `.env` for local development (NEVER commit the real `.env`).
# On Vercel: Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Admin authentication (required in production) -------------------------
# Bcrypt hash of the admin password (SHA-256 pre-hash + bcrypt, cost 12).
# Generate your own with:
#   python -c "import bcrypt,hashlib;print(bcrypt.hashpw(hashlib.sha256(b'YOUR-PASSWORD').digest(),bcrypt.gensalt(12)).decode())"
# This sample hash is for the intended demo password `admin111322?`.
ADMIN_PASSWORD_HASH=$2b$12$h6h/eTk/hjGZJykEX48yHePDgpLKcjGtgBlPnl26clsnP5Bf/Xgpm

# Optional local-dev convenience. Used ONLY when ADMIN_PASSWORD_HASH is unset.
# The server hashes it at startup; it is never sent to the browser.
# ADMIN_PASSWORD=admin111322?

# --- Sessions (required in production) -------------------------------------
# Long, random string (32+ chars). Rotating it invalidates all sessions.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-secret

# --- JSONBin.io storage (required for visitor analytics + admin data) ------
# Create a bin at https://jsonbin.io (or via the API), then put its id here.
JSONBIN_BIN_ID=
# Account "X-Master-Key" from https://jsonbin.io/api-keys
JSONBIN_MASTER_KEY=
# Optional: scoped access key (if you prefer access keys over the master key).
JSONBIN_ACCESS_KEY=

# --- Application behaviour -------------------------------------------------
# production | development  (production enables Secure cookies + strict errors)
ENV=development

# auto | true | false — cookie Secure flag. `auto` = Secure when request is HTTPS.
COOKIE_SECURE=auto

# Admin session lifetime in hours.
SESSION_TTL_HOURS=8

# Visitor records older than this many days are trimmed on each write.
VISITOR_RETENTION_DAYS=90

# true = mask the last IP octet (/24) or IPv6 suffix before storing.
ANONYMIZE_IP=false

# Login brute-force protection (per-instance, best effort on serverless).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Visit tracking throttle per IP.
TRACK_RATE_LIMIT_ATTEMPTS=30
TRACK_RATE_LIMIT_WINDOW_SECONDS=60

# JSONBin HTTP timeout in seconds.
JSONBIN_TIMEOUT_SECONDS=10

# Comma-separated extra origins allowed to call state-changing endpoints
# (in addition to the request's own origin). Useful for local testing.
# EXTRA_ALLOWED_ORIGINS=http://localhost:3000
